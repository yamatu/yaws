PORT=3001
DATABASE_PATH=./data/yaws.sqlite
# Generate each secret with: openssl rand -hex 32
JWT_SECRET=
AGENT_KEY_SECRET=
# Only set during a one-time AGENT_KEY_SECRET rotation.
AGENT_KEY_SECRET_PREVIOUS=
# Cross-origin API access. Leave empty to disable (the dashboard is served same-origin).
# Development uses http://localhost:5173 automatically.
CORS_ORIGIN=
# Reverse proxy hops in front of the app: 1 = documented Nginx setup (trusts
# X-Forwarded-For from that proxy), 0 = the port is reachable directly by clients.
TRUST_PROXY=1
METRICS_RETENTION_DAYS=30
METRICS_PRUNE_INTERVAL_MIN=10
# Restore upload limit (MB), default 2048
ADMIN_RESTORE_MAX_MB=2048
# Optional: telegram notification (can also be configured in admin UI)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
AGENT_GITHUB_REPO=yamatu/yaws
# Optional override; otherwise uses https://github.com/$AGENT_GITHUB_REPO/releases/latest/download
AGENT_RELEASE_BASE_URL=
# Automatic Let's Encrypt certificate renewal (Cloudflare DNS challenge)
CERT_EMAIL=yamatu@qq.com
# Cloudflare API Token (needs Zone -> DNS -> Edit); leave empty to use CF_Key
CF_Token=
CF_Account_ID=
# Alternative: legacy Global API Key + the Cloudflare account e-mail
CF_Key=
CF_Email=
# ACME CA passed to acme.sh --server (letsencrypt | zerossl | buypass | ...)
CERT_CA_SERVER=letsencrypt
# Set to "server" to pass no CF_* at all and let acme.sh use its own account.conf
CERT_USE_SERVER_CREDS=
