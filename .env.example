# Generate each secret with: openssl rand -hex 32
JWT_SECRET=
BOOTSTRAP_TOKEN=
AGENT_KEY_SECRET=
# Only set during a one-time AGENT_KEY_SECRET rotation.
AGENT_KEY_SECRET_PREVIOUS=
CORS_ORIGIN=http://localhost:3001
# Automatic Let's Encrypt certificate renewal (Cloudflare DNS challenge)
CERT_EMAIL=yamatu@qq.com
# Cloudflare API Token (needs Zone -> DNS -> Edit); leave empty to use CF_Key
CF_Token=
CF_Account_ID=
# Alternative: legacy Global API Key + the Cloudflare account e-mail
CF_Key=
CF_Email=
# ACME CA passed to acme.sh --server (letsencrypt | zerossl | buypass | ...)
CERT_CA_SERVER=letsencrypt
# Set to "server" to pass no CF_* at all and let acme.sh use its own account.conf
CERT_USE_SERVER_CREDS=
